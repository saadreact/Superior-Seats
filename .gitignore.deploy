# Deployment branch .gitignore
# This file allows .next folder to be committed for deployment branch
# Copy this to .gitignore when working on the deploy branch

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
package-lock.json

# testing
/coverage

# next.js - NOTE: .next/ is ALLOWED in deploy branch
# /.next/  <-- Commented out to allow .next folder
/out/

# production
/build

# misc
.DS_Store
*.pem

# documentation files

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# environment files - NEVER commit these to version control
.env
.env.local
.env.development
.env.production
.env.main
env.local
env.development
env.production
env.main
env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
# next-env.d.ts  <-- Commented out to allow this file

